page { background: #edf4ee; color: #17352c; font-family: "PingFang SC","Microsoft YaHei",sans-serif; font-size: 14px; line-height: 1.4; }
view, text, button, input, picker { box-sizing: border-box; }
button { margin: 0; padding: 0; min-width: 0; border: 0; line-height: 1.4; font-family: inherit; font-size: inherit; border-radius: 0; }
button::after { border: 0; }
.app-shell button { margin: 0; width: auto; line-height: 1.4; }
input { min-width: 0; font-family: inherit; }
.app-shell { width: 100%; max-width: 520px; min-height: 100vh; margin: 0 auto; background: #f5f8f4; position: relative; overflow: hidden; }
.entry-page { min-height: 100vh; padding: 74px 28px 36px; padding-bottom: calc(36px + env(safe-area-inset-bottom)); position: relative; display: flex; flex-direction: column; }
.entry-glow { position: absolute; width: 280px; height: 280px; right: -112px; top: -84px; background: #d8eee1; border-radius: 50%; opacity: .8; pointer-events: none; }
.brand-mark { position: relative; flex-shrink: 0; width: 62px; height: 62px; border-radius: 19px; background: #238b68; display: flex; align-items: center; justify-content: center; box-shadow: 0 10px 24px rgba(35,139,104,.22); }
.feather { width: 12px; height: 35px; border: 3px solid #fff; border-radius: 80% 20% 80% 20%; transform: rotate(32deg); display: block; position: relative; }
.feather::after { content: ""; position: absolute; height: 18px; width: 3px; left: 2px; bottom: -10px; background: #fff; transform: rotate(-26deg); }
.entry-hero { position: relative; }
.eyebrow { display: block; color: #238b68; font-size: 11px; letter-spacing: .12em; font-weight: 800; }
.entry-title { font-size: 52px; letter-spacing: -.06em; line-height: 1; margin: 28px 0 16px; font-weight: 850; }
.entry-copy { display: block; max-width: 280px; color: #769087; line-height: 1.7; font-size: 15px; }
.entry-mode-switch { position: relative; display: flex; margin-top: 30px; padding: 4px; background: #e4f1e8; border-radius: 13px; }
.entry-mode-switch .entry-mode-button { flex: 1; width: 0; background: transparent; color: #769087; border-radius: 10px; padding: 10px 8px; font-size: 13px; font-weight: 800; }
.entry-mode-button + .entry-mode-button { margin-left: 6px; }
.entry-mode-button.active { background: #fff; color: #17644d; box-shadow: 0 3px 10px rgba(23,100,77,.09); }
.entry-form-card { position: relative; margin-top: auto; padding-top: 24px; }
.form-label { display: block; font-weight: 700; font-size: 13px; margin-bottom: 9px; }
.form-input { width: 100%; height: 52px; border: 1px solid #dce9df; background: #fff; color: #17352c; border-radius: 13px; padding: 0 16px; font-size: 16px; }
.form-input + .form-label { margin-top: 14px; }
.invite-input { letter-spacing: .26em; }
.form-helper { display: block; color: #769087; font-size: 11px; line-height: 1.6; margin-top: 10px; }
.form-error { display: block; color: #c75c54; font-size: 12px; margin-top: 8px; }
.app-shell .primary-button { position: relative; background: #238b68; color: #fff; padding: 15px 18px; border-radius: 13px; font-size: 16px; font-weight: 800; box-shadow: 0 10px 22px rgba(35,139,104,.17); }
.primary-button.full-button { width: 100%; margin-top: 14px; }
.button-arrow { position: absolute; right: 18px; top: 50%; transform: translateY(-50%); font-size: 20px; line-height: 1; }
.entry-notice { display: block; margin-top: 22px; color: #769087; font-size: 12px; }
.main-page { min-height: 100vh; }
.topbar { display: flex; justify-content: space-between; align-items: flex-start; padding: 26px 22px 14px; }
.topbar-copy { flex: 1; min-width: 0; padding-right: 10px; }
.topbar-title { color: #17352c; font-size: 22px; font-weight: 900; letter-spacing: -.04em; margin-top: 6px; word-break: break-all; }
.topbar .icon-button { flex-shrink: 0; width: 40px; height: 40px; border-radius: 12px; border: 1px solid #dce9df; background: #fff; color: #238b68; display: flex; align-items: center; justify-content: center; font-size: 17px; }
.message { margin: 0 18px 10px; border-radius: 10px; padding: 10px 14px; font-size: 12px; word-break: break-all; }
.error-message { color: #c75c54; background: #fdebe7; }
.notice-message { color: #17644d; background: #e4f1e8; }
.content { padding: 5px 18px 104px; padding-bottom: calc(104px + env(safe-area-inset-bottom)); }
.admin-page { padding-bottom: calc(28px + env(safe-area-inset-bottom)); }
.status-line { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; margin: 6px 2px 14px; font-size: 12px; }
.live-pill { display: inline-flex; align-items: center; color: #238b68; background: #e4f1e8; padding: 6px 10px; border-radius: 20px; font-weight: 800; }
.live-dot { display: inline-block; width: 7px; height: 7px; background: #f29f58; border-radius: 50%; margin-right: 7px; }
.muted { color: #769087; }
.court-card { position: relative; overflow: hidden; background: #fff; border: 1px solid #d9eadf; border-radius: 21px; padding: 20px 16px 18px; box-shadow: 0 18px 48px rgba(37,73,55,.11); }
.court-lines { position: absolute; top: 44px; right: 15px; bottom: 58px; left: 15px; border: 1px solid rgba(35,139,104,.12); pointer-events: none; }
.court-line-left, .court-line-right { position: absolute; top: 0; bottom: 0; border-left: 1px solid rgba(35,139,104,.1); }
.court-line-left { left: 31%; }
.court-line-right { right: 31%; }
.round-heading { position: relative; display: flex; justify-content: space-between; align-items: center; color: #17352c; font-weight: 850; font-size: 14px; }
.round-time { color: #769087; font-size: 11px; font-weight: 500; }
.scoreboard { position: relative; display: flex; align-items: center; padding: 23px 0 10px; }
.team { flex: 1; min-width: 0; text-align: center; }
.team-label { display: block; color: #769087; font-size: 11px; font-weight: 800; }
.team-dot { display: inline-block; width: 8px; height: 8px; margin-right: 4px; border-radius: 50%; background: #238b68; }
.orange-dot { background: #f29f58; }
.team-names { display: flex; align-items: center; justify-content: center; min-height: 40px; margin: 9px 0 12px; color: #17352c; font-size: 14px; font-weight: 850; line-height: 1.4; white-space: normal; word-break: break-all; }
.score-input { width: 82px; max-width: 100%; height: 66px; margin: 0 auto; border: 0; background: #e6f3eb; color: #238b68; border-radius: 15px; text-align: center; font-size: 45px; font-weight: 850; letter-spacing: -.08em; padding: 6px 2px; }
.orange-score { background: #fff0e2; color: #dd7b2f; }
.versus { flex: 0 0 42px; color: #a2b3a8; font-size: 11px; font-weight: 800; text-align: center; }
.score-hint { position: relative; display: block; color: #769087; font-size: 11px; text-align: center; margin-top: 4px; }
.empty-card { padding: 32px 16px; background: #fff; border: 1px solid #dce9df; border-radius: 21px; text-align: center; }
.empty-icon { display: block; color: #238b68; font-size: 36px; }
.empty-title { font-size: 18px; font-weight: 800; margin-bottom: 10px; }
.empty-card .muted { font-size: 12px; line-height: 1.6; }
.next-card { margin-top: 13px; padding: 15px 16px; background: #edf5f0; border-radius: 15px; }
.next-title { display: flex; justify-content: space-between; align-items: center; color: #17644d; font-size: 11px; font-weight: 850; }
.rest-label { color: #4e83d7; font-weight: 700; }
.next-players { padding: 10px 0 8px; display: flex; align-items: center; }
.next-team { flex: 1; min-width: 0; color: #17352c; font-size: 14px; font-weight: 900; line-height: 1.45; word-break: break-all; }
.next-team:last-child { text-align: right; }
.vs-chip { flex-shrink: 0; margin: 0 10px; color: #238b68; background: #fff; border: 1px solid #d6e9dc; border-radius: 999px; padding: 5px 7px; font-size: 10px; font-weight: 800; letter-spacing: .08em; }
.rest-strip { display: block; color: #769087; font-size: 11px; }
.rest-dot { width: 6px; height: 6px; display: inline-block; border-radius: 50%; background: #4e83d7; margin-right: 6px; }
.quick-stats { display: flex; border-top: 1px solid #dce9df; margin-top: 22px; padding-top: 18px; }
.stat { flex: 1; min-width: 0; text-align: center; border-right: 1px solid #dce9df; }
.stat:last-child { border-right: 0; }
.stat-value { display: block; font-size: 22px; font-weight: 800; letter-spacing: -.04em; }
.stat-caption { display: block; color: #769087; font-size: 11px; margin-top: 4px; }
.unit { color: #238b68; font-size: 13px; font-weight: 800; }
.page-heading { display: flex; justify-content: space-between; align-items: center; padding: 10px 1px 18px; }
.page-title { font-size: 29px; font-weight: 800; letter-spacing: -.06em; margin-top: 5px; }
.count-chip { flex-shrink: 0; background: #e4f1e8; color: #238b68; font-weight: 800; font-size: 11px; padding: 8px 10px; border-radius: 10px; }
.filter-tabs { display: flex; flex-wrap: wrap; margin-bottom: 5px; }
.filter-tabs .filter-tab { width: auto; border: 1px solid #dce9df; background: #fff; color: #769087; border-radius: 9px; padding: 8px 11px; font-size: 12px; margin-right: 8px; margin-bottom: 8px; }
.filter-tab.active { background: #238b68; border-color: #238b68; color: #fff; }
.schedule-row { display: flex; align-items: flex-start; background: #fff; border: 1px solid #dce9df; border-radius: 14px; padding: 13px 12px; margin-bottom: 9px; }
.schedule-row.active { border-color: #9ed0b4; box-shadow: 0 8px 18px rgba(35,139,104,.09); }
.schedule-row.completed { color: #17352c; }
.round-index { flex: 0 0 30px; margin-right: 12px; padding-top: 3px; color: #769087; font-size: 11px; text-align: center; }
.matchup { flex: 1; min-width: 0; }
.matchup-line { display: flex; justify-content: space-between; align-items: center; padding: 2px 0; }
.matchup-name { flex: 1; min-width: 0; margin-right: 8px; color: #17352c; font-size: 14px; font-weight: 800; line-height: 1.35; white-space: normal; word-break: break-all; }
.matchup-score { flex-shrink: 0; color: #238b68; font-size: 14px; font-weight: 900; }
.row-status { flex-shrink: 0; margin-left: 12px; padding-top: 3px; color: #769087; font-size: 10px; white-space: nowrap; }
.section-note { display: block; color: #769087; font-size: 11px; line-height: 1.6; margin: 15px 2px; }
.ranking-hero { display: flex; align-items: center; background: #238b68; color: #fff; border-radius: 18px; padding: 18px 17px; margin-bottom: 13px; box-shadow: 0 12px 25px rgba(35,139,104,.2); }
.hero-number { flex-shrink: 0; margin-right: 13px; font-size: 36px; font-weight: 900; letter-spacing: -.08em; }
.hero-copy { flex: 1; min-width: 0; font-size: 11px; }
.hero-name { display: block; font-size: 15px; font-weight: 800; margin-top: 3px; word-break: break-all; }
.spark { flex-shrink: 0; margin-left: 10px; font-size: 24px; }
.ranking-row { display: flex; align-items: center; background: #fff; border: 1px solid #dce9df; border-radius: 14px; padding: 12px; margin-bottom: 8px; }
.ranking-row.leader { border-color: #9ed0b4; }
.rank-number { flex: 0 0 24px; margin-right: 10px; color: #769087; font-size: 12px; font-weight: 850; }
.avatar { flex-shrink: 0; width: 35px; height: 35px; margin-right: 10px; display: flex; align-items: center; justify-content: center; color: #fff; border-radius: 11px; font-size: 15px; font-weight: 850; }
.avatar-small { width: 30px; height: 30px; margin-right: 8px; border-radius: 9px; font-size: 12px; }
.avatar-0 { background: #238b68; }
.avatar-1 { background: #f29f58; }
.avatar-2 { background: #4e83d7; }
.avatar-3 { background: #8b72d9; }
.avatar-4 { background: #d47596; }
.rank-name { flex: 1; min-width: 0; margin-right: 10px; }
.player-name { display: block; font-size: 13px; font-weight: 800; word-break: break-all; }
.player-record { display: block; color: #769087; font-size: 10px; margin-top: 4px; }
.net-score { flex-shrink: 0; color: #238b68; font-size: 18px; font-weight: 800; letter-spacing: -.04em; }
.net-score.negative { color: #c75c54; }
.bottom-nav { position: fixed; left: 0; right: 0; bottom: 0; width: 100%; max-width: 520px; margin: 0 auto; display: flex; padding: 10px; padding-bottom: calc(10px + env(safe-area-inset-bottom)); background: rgba(255,255,255,.94); border-top: 1px solid #dce9df; z-index: 5; }
.bottom-nav .nav-item { flex: 1; min-width: 0; width: 0; background: transparent; color: #769087; font-size: 10px; display: flex; flex-direction: column; align-items: center; padding: 0; }
.nav-item.active { color: #238b68; font-weight: 850; }
.nav-icon { display: block; font-size: 18px; line-height: 16px; margin-bottom: 5px; }
.admin-page .admin-return { display: block; width: auto; background: transparent; color: #238b68; font-size: 13px; font-weight: 800; padding: 8px 0 14px; text-align: left; }
.admin-summary { display: flex; background: #fff; border: 1px solid #dce9df; border-radius: 15px; padding: 15px 5px; margin-bottom: 13px; }
.summary-item { flex: 1; min-width: 0; text-align: center; border-right: 1px solid #dce9df; }
.summary-item:last-child { border-right: 0; }
.summary-value { display: block; font-size: 17px; font-weight: 800; }
.summary-label { display: block; color: #769087; font-size: 10px; margin-top: 4px; }
.admin-panel { background: #fff; border: 1px solid #dce9df; border-radius: 16px; padding: 16px 14px; margin-bottom: 13px; }
.panel-heading { display: flex; justify-content: space-between; align-items: center; }
.panel-title { font-size: 15px; font-weight: 800; }
.panel-subtitle { color: #769087; font-size: 10px; }
.player-row { display: flex; align-items: center; padding: 11px 0; border-bottom: 1px solid #edf3ed; font-size: 13px; }
.player-name-input { flex: 1; min-width: 0; height: 32px; color: #17352c; background: transparent; font-size: 14px; font-weight: 850; }
.player-level { flex-shrink: 0; margin-left: 8px; }
.level-badge { display: block; padding: 4px 8px; border-radius: 6px; font-size: 10px; font-weight: 850; }
.level-H { color: #c75c54; background: #fdebe7; }
.level-M { color: #bd772f; background: #fff0df; }
.level-X { color: #8b62b8; background: #f1eaff; }
.level-L { color: #4e83d7; background: #e9f0ff; }
.player-row .remove-button, .modal-top .close-button { flex-shrink: 0; width: auto; background: transparent; color: #c75c54; font-size: 21px; line-height: 1; padding: 3px; }
.player-row .remove-button { margin-left: 8px; }
.add-player { display: flex; align-items: center; padding-top: 12px; }
.add-player-name { flex: 1; min-width: 0; width: 0; height: 38px; padding: 0 8px; border-radius: 9px; font-size: 12px; }
.new-level { flex: 0 0 58px; margin-left: 7px; border: 1px solid #dce9df; border-radius: 9px; background: #fff; color: #17352c; padding: 10px 5px; font-size: 12px; text-align: center; }
.add-player .small-button { flex: 0 0 48px; width: 48px; margin-left: 7px; height: 38px; border-radius: 9px; background: #238b68; color: #fff; font-size: 11px; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.roster-tools { display: flex; align-items: center; justify-content: space-between; padding-top: 12px; color: #769087; font-size: 10px; line-height: 1.4; }
.roster-tools .roster-save-button { flex-shrink: 0; width: auto; margin-left: 10px; border: 1px solid #b9dcc7; background: #edf7f0; color: #17644d; border-radius: 9px; padding: 8px 10px; font-size: 11px; font-weight: 850; }
.rule-copy { display: block; background: #f1f7f2; color: #17644d; padding: 11px; border-radius: 9px; font-size: 11px; margin-top: 14px; }
.extension-actions { margin-top: 12px; color: #769087; font-size: 11px; }
.extension-buttons { display: flex; margin-top: 8px; }
.extension-buttons .extension-button { flex: 1; width: 0; border: 1px solid #dce9df; background: #f1f7f2; color: #17644d; border-radius: 9px; padding: 10px 6px; font-size: 11px; font-weight: 800; }
.modal-backdrop { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 30; background: rgba(23,53,44,.28); display: flex; align-items: flex-end; padding: 0 12px 12px; }
.edit-modal { width: 100%; max-width: 520px; max-height: 72vh; overflow-y: auto; margin: 0 auto; background: #f5f8f4; border-radius: 22px; padding: 22px 19px; padding-bottom: calc(22px + env(safe-area-inset-bottom)); box-shadow: 0 -14px 40px rgba(23,53,44,.16); }
.modal-top { display: flex; justify-content: space-between; align-items: flex-start; }
.modal-title { margin-top: 6px; font-size: 24px; font-weight: 800; letter-spacing: -.05em; }
.modal-matchup { display: block; color: #17352c; font-size: 14px; font-weight: 800; line-height: 1.55; text-align: center; margin: 22px 0; word-break: break-all; }
.edit-score-grid { display: flex; align-items: center; }
.edit-score-input { flex: 1; min-width: 0; width: 0; height: 66px; border: 1px solid #dce9df; border-radius: 13px; background: #fff; padding: 13px; text-align: center; font-size: 28px; font-weight: 850; color: #238b68; }
.edit-score-grid text { flex: 0 0 42px; text-align: center; color: #769087; font-weight: 800; }
@media (max-width: 380px) {
  .next-team, .matchup-name { font-size: 13px; }
  .vs-chip { margin: 0 6px; }
  .row-status { font-size: 9px; margin-left: 8px; }
  .roster-tools { align-items: flex-start; flex-direction: column; }
  .roster-tools .roster-save-button { width: 100%; margin: 8px 0 0; }
}
