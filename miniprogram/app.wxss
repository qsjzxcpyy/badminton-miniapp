page { background: #071b2e; color: #f6fbff; font-family: -apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC",sans-serif; }
.container { min-height: 100vh; box-sizing: border-box; padding: 36rpx 30rpx 150rpx; background: radial-gradient(circle at 80% 0%, #174d5b 0, #071b2e 48%, #061321 100%); }
.brand { margin: 40rpx 0 60rpx; } .eyebrow { color:#65e6c0; letter-spacing:4rpx; font-size:22rpx; } h1 { font-size:58rpx; line-height:1.1; margin:20rpx 0; } h2 { font-size:40rpx; margin:8rpx 0 0; } h3 { font-size:34rpx; margin:8rpx 0 26rpx; }
.card { background:rgba(16,44,65,.9); border:1rpx solid rgba(126,224,202,.18); border-radius:28rpx; padding:30rpx; margin-bottom:24rpx; box-shadow:0 18rpx 50rpx rgba(0,0,0,.18); }
input, picker { box-sizing:border-box; width:100%; height:92rpx; border-radius:16rpx; padding:0 24rpx; background:#f3f8fb; color:#102538; margin:14rpx 0 20rpx; font-size:30rpx; } button { border:0; border-radius:18rpx; font-size:29rpx; } .primary { background:#55d9b4; color:#062031; font-weight:700; padding:24rpx; } .secondary { background:#163c56; color:#ddfbf2; padding:20rpx 24rpx; } .danger { background:#65384a; color:#ffdce6; padding:18rpx; }
.segment { display:flex; gap:12rpx; margin-bottom:26rpx; } .segment button { flex:1; padding:20rpx 8rpx; background:#12354d; color:#9ab4c6; } .segment .selected { background:#55d9b4; color:#062031; }
.muted { color:#9bb0c0; font-size:24rpx; } .error { color:#ff9eaf; font-size:25rpx; margin:0 0 16rpx; } .success { color:#65e6c0; font-size:25rpx; }
.topline { display:flex; justify-content:space-between; align-items:center; margin-bottom:28rpx; } .pill { border-radius:40rpx; background:#173f4f; color:#6eebc7; padding:12rpx 20rpx; font-size:23rpx; }
.score-card { position:relative; overflow:hidden; } .score-card:before { content:""; position:absolute; width:220rpx; height:220rpx; border-radius:50%; background:#1d806e; opacity:.25; right:-100rpx; top:-100rpx; } .score-grid { display:flex; align-items:center; justify-content:space-between; gap:12rpx; } .team { flex:1; text-align:center; } .team-name { min-height:82rpx; font-weight:700; font-size:31rpx; line-height:1.35; display:flex; justify-content:center; align-items:center; } .vs { color:#65e6c0; font-weight:800; } .score-input { height:100rpx; text-align:center; font-size:48rpx; font-weight:800; color:#08243a; padding:0; margin:14rpx 0; } .orange { background:#ffdcb2; } .hint { color:#9bb0c0; text-align:center; font-size:23rpx; }
.nav { position:fixed; bottom:0; left:0; right:0; height:124rpx; padding-bottom:env(safe-area-inset-bottom); display:flex; background:rgba(6,20,33,.97); border-top:1rpx solid rgba(133,214,199,.16); z-index:10; } .nav-item { flex:1; background:transparent; color:#839bab; font-size:23rpx; border-radius:0; padding-top:18rpx; } .nav-item.active { color:#65e6c0; } .nav-icon { display:block; font-size:34rpx; margin-bottom:5rpx; }
.row { display:flex; align-items:center; gap:18rpx; padding:24rpx 0; border-bottom:1rpx solid rgba(148,197,210,.12); } .row:last-child { border-bottom:0; } .index { color:#65e6c0; width:48rpx; } .row-main { flex:1; } .row-name { font-size:29rpx; font-weight:700; color:#f7fbff; } .row-sub { color:#9bb0c0; font-size:23rpx; margin-top:8rpx; } .net { font-size:32rpx; font-weight:800; color:#65e6c0; } .negative { color:#ff9eaf; }
.admin-player { display:flex; align-items:center; gap:12rpx; flex-wrap:wrap; } .admin-player input { flex:1; min-width:190rpx; margin:0; height:70rpx; } .admin-player picker { width:150rpx; margin:0; height:70rpx; padding:18rpx; } .remove { width:70rpx; padding:15rpx 0; background:#65384a; color:#ffdce6; } .level { color:#ffd28b; font-size:23rpx; } .round-status { font-size:22rpx; color:#9bb0c0; } .round-status.active { color:#65e6c0; } .round-score { font-size:28rpx; font-weight:700; }
.modal { position:fixed; inset:0; background:rgba(0,0,0,.65); display:flex; align-items:flex-end; z-index:20; } .modal-card { width:100%; box-sizing:border-box; border-radius:30rpx 30rpx 0 0; background:#102c41; padding:34rpx 30rpx 55rpx; } .modal-score { display:flex; align-items:center; gap:16rpx; } .modal-score input { text-align:center; font-size:46rpx; }
