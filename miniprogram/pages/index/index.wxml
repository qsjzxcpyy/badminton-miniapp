<view class="container">
  <block wx:if="{{screen === 'entry'}}">
    <view class="brand"><text class="eyebrow">ONE COURT · MANY RALLIES</text><h1>羽毛球<br/>友谊赛</h1><text class="muted">把每一分、每一场和每一次轮换都记录下来。</text></view>
    <view class="segment"><button class="{{entryMode === 'join' ? 'selected' : ''}}" data-mode="join" bindtap="chooseEntry">加入比赛</button><button class="{{entryMode === 'create' ? 'selected' : ''}}" data-mode="create" bindtap="chooseEntry">创建比赛</button></view>
    <view class="card" wx:if="{{entryMode === 'join'}}"><text class="muted">比赛邀请码</text><input data-field="inviteCode" value="{{inviteCode}}" maxlength="6" type="number" placeholder="输入 6 位数字" bindinput="onInput"/><button class="primary" bindtap="enterMatch">进入比赛</button></view>
    <view class="card" wx:else><text class="muted">比赛名称</text><input data-field="createName" value="{{createName}}" maxlength="24" bindinput="onInput"/><text class="muted">设置邀请码</text><input data-field="createInvite" value="{{createInvite}}" maxlength="6" type="number" placeholder="输入 6 位数字" bindinput="onInput"/><button class="primary" bindtap="createMatch">创建并进入管理</button></view>
    <text class="error" wx:if="{{error}}">{{error}}</text><text class="success" wx:if="{{notice}}">{{notice}}</text>
  </block>
  <block wx:else>
    <view class="topline"><view><text class="eyebrow">BADMINTON · COURT 01</text><h2>{{match.name}}</h2></view><text class="pill">{{isCreator ? '创建者' : '参赛者'}}</text></view>
    <text class="error" wx:if="{{error}}">{{error}}</text><text class="success" wx:if="{{notice}}">{{notice}}</text>
    <block wx:if="{{screen === 'match'}}">
      <view class="card score-card" wx:if="{{currentRound}}"><view class="topline"><text class="eyebrow">第 {{currentRound.seq}} 局 · 正在进行</text><text class="muted">净胜分实时更新</text></view><view class="score-grid"><view class="team"><text class="team-name">{{currentRound.team1}}</text><input class="score-input" data-field="score1" value="{{score1}}" type="number" min="0" bindinput="onInput"/></view><text class="vs">VS</text><view class="team"><text class="team-name">{{currentRound.team2}}</text><input class="score-input orange" data-field="score2" value="{{score2}}" type="number" min="0" bindinput="onInput"/></view></view><text class="hint">比分只需填写非负整数，没有上限</text><button class="primary" bindtap="submitScore">提交本局比分</button></view>
      <view class="card" wx:else><h3>今天的球局打完了</h3><text class="muted">去赛程查看全部对局，去排名查看净胜分。</text></view>
      <view class="card" wx:if="{{nextRound}}"><text class="eyebrow">下一局</text><view class="team-name">{{nextRound.team1}} <text class="vs"> VS </text> {{nextRound.team2}}</view><text class="hint">其余球员休息，继续轮换</text></view>
      <view class="card"><view class="topline"><text>参赛球员</text><text class="pill">{{players.length}} 人</text></view><text class="muted">比分和排名保存在云端，所有参与者看到同一份数据。</text></view>
    </block>
    <block wx:elif="{{screen === 'schedule'}}"><view class="topline"><view><text class="eyebrow">COURT ROTATION</text><h3>完整赛程</h3></view><text class="pill">{{rounds.length}} 局</text></view><view class="card"><block wx:for="{{rounds}}" wx:key="id"><view class="row" data-id="{{item.id}}" bindtap="openEdit"><text class="index">{{item.seq}}</text><view class="row-main"><text class="row-name">{{item.team1}}</text><text class="row-name">{{item.team2}}</text><text class="row-sub">{{item.status === 'active' ? '进行中' : item.status === 'completed' ? '已完成 · 点击修改比分' : '待开始'}}</text></view><text class="round-score">{{item.score1 === null ? '—' : item.score1}} : {{item.score2 === null ? '—' : item.score2}}</text></view></block></view></block>
    <block wx:elif="{{screen === 'ranking'}}"><view class="topline"><view><text class="eyebrow">NET SCOREBOARD</text><h3>实时排名</h3></view><text class="pill">按净胜分</text></view><view class="card"><block wx:for="{{ranking}}" wx:key="id"><view class="row"><text class="index">{{index + 1}}</text><view class="row-main"><text class="row-name">{{item.name}}</text><text class="row-sub">{{item.wins}} 胜 · {{item.games}} 局</text></view><text class="net {{item.net < 0 ? 'negative' : ''}}">{{item.net > 0 ? '+' : ''}}{{item.net}}</text></view></block></view><text class="muted">净胜分 = 所在一方得分 − 对方得分；修改历史比分后会自动重算。</text></block>
    <block wx:elif="{{screen === 'admin'}}"><view class="topline"><view><text class="eyebrow">CONTROL ROOM</text><h3>比赛管理</h3></view><text class="pill">仅创建者</text></view><view class="card"><text class="muted">参赛名单和等级仅创建者可见，普通球员不会看到等级。</text><block wx:for="{{adminPlayers}}" wx:key="id"><view class="row admin-player"><input value="{{item.name}}" data-id="{{item.id}}" data-field="name" bindinput="changePlayer" bindblur="savePlayerEdits"/><picker range="{{levels}}" value="{{item.levelIndex}}" data-id="{{item.id}}" data-field="level" bindchange="changePlayer"><view class="level">{{levelName(item.level)}} ▾</view></picker><button class="remove" data-id="{{item.id}}" bindtap="removePlayer">{{item.status === 'withdrawn' ? '恢复' : '退出'}}</button></view></block><view class="row admin-player"><input data-field="newPlayerName" value="{{newPlayerName}}" placeholder="添加球员姓名" bindinput="onInput"/><picker range="{{levels}}" value="1" data-field="newPlayerLevel" bindchange="changeNewLevel"><view class="level">添加等级 ▾</view></picker></view><button class="secondary" bindtap="addPlayer">添加球员</button><button class="secondary" bindtap="saveDefaultRoster">保存为下次默认名单</button></view><view class="card"><view class="topline"><text>赛程控制</text><text class="muted">默认 15 局</text></view><text class="muted">算法会优先安排最长时间未上场的人，并控制局数差、连打和搭档新鲜度。</text><button class="primary" bindtap="generateSchedule">生成 / 重排待开始赛程</button><button class="secondary" bindtap="extendSchedule">追加 5 局</button></view><text class="muted">当前 {{players.length}} 人 · 已生成 {{rounds.length}} 局</text></block>
    <view class="nav"><button class="nav-item {{screen === 'match' ? 'active' : ''}}" data-screen="match" bindtap="switchScreen"><text class="nav-icon">●</text>比赛</button><button class="nav-item {{screen === 'schedule' ? 'active' : ''}}" data-screen="schedule" bindtap="switchScreen"><text class="nav-icon">▤</text>赛程</button><button class="nav-item {{screen === 'ranking' ? 'active' : ''}}" data-screen="ranking" bindtap="switchScreen"><text class="nav-icon">↗</text>排名</button><button wx:if="{{isCreator}}" class="nav-item {{screen === 'admin' ? 'active' : ''}}" data-screen="admin" bindtap="switchScreen"><text class="nav-icon">⚙</text>管理</button></view>
  </block>
  <view class="modal" wx:if="{{editingRound}}" catchtap="closeEdit"><view class="modal-card" catchtap="noop"><view class="topline"><view><text class="eyebrow">EDIT SCORE</text><h3>修改第 {{editingRound.seq}} 局</h3></view><button class="secondary" bindtap="closeEdit">关闭</button></view><text class="row-name">{{editingRound.team1}} VS {{editingRound.team2}}</text><view class="modal-score"><input data-field="editScore1" value="{{editScore1}}" type="number" bindinput="onInput"/><text>:</text><input data-field="editScore2" value="{{editScore2}}" type="number" bindinput="onInput"/></view><button class="primary" bindtap="saveEdit">保存新比分</button></view></view>
</view>







